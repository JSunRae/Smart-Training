{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@core/*": ["./packages/core/src/*"],
      "@prompts/*": ["./packages/prompts/*"]
    }
  },
  "include": ["packages", "scripts", "e2e", "playwright.config.ts", "vitest.config.ts"]
}
