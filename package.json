{
  "name": "sales-challenger-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-driven sales training monorepo scaffold",
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.13",
      "brace-expansion@>=5 <6": "5.0.6",
      "flatted": "3.4.2",
      "postcss": "8.5.14",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "@babel/core@<=7.29.0": "7.29.6",
      "js-yaml@>=4.0.0 <=4.1.1": "4.2.0",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1"
    }
  },
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build": "pnpm build:web && pnpm build:api",
    "start:web": "pnpm --filter web start",
    "start:api": "pnpm --filter api start",
    "typecheck": "tsc --noEmit && pnpm --filter web exec tsc --noEmit && pnpm --filter api exec tsc --noEmit",
    "lint": "eslint . && pnpm --filter web lint && pnpm --filter api lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "smoke:hosted": "node scripts/smoke-hosted.mjs",
    "pilot:gate": "pnpm release:check && pnpm smoke:hosted",
    "release:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e && pnpm audit --prod",
    "seed": "pnpm --filter api db:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.8.2",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "openai": "^4.104.0"
  }
}
