# Runtime
NODE_ENV=development
PORT=3000
API_PORT=3001
# Local/Render default: workspace. Netlify defaults to marketing (no backend).
# pilot: branded home + workspace; requires a public HTTPS API origin on Netlify.
SMART_TRAINING_SITE_MODE=workspace
INTERNAL_API_ORIGIN=http://localhost:3001
# Optional private-network shortcut for hosted deployments such as Render.
INTERNAL_API_HOSTPORT=
# Optional public API origin. The current web app can run without this when INTERNAL_API_ORIGIN
# or INTERNAL_API_HOSTPORT is set.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# Preferred hosted persistence
DATABASE_URL=

# Local store
# Used only when DATABASE_URL is unset. Stored under apps/api/data/<filename> at runtime.
SMART_TRAINING_DB_PATH=store.json

# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_ENABLED=false
VOICE_LAB_ENABLED=false
OPENAI_MODEL=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Session auth
# Unset defaults to workspace outside production and closed in production.
# Set invite on the API only for an approved controlled pilot or isolated test.
PILOT_ACCESS_MODE=
APP_SESSION_SECRET=change-me-before-production
DATA_ENCRYPTION_KEY=
SESSION_RETENTION_DAYS=30

# App defaults
DEFAULT_ORG_NAME=Northstar Enablement

# Public pilot support surface
NEXT_PUBLIC_SUPPORT_NAME=Smart Training Pilot Support
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_URL=

# Optional externally hosted enquiry processor. Netlify marketing deployments use
# the detected /__forms.html form when this is unset. The visible email link and
# the no-JavaScript email fallback remain available for recovery.
NEXT_PUBLIC_ENQUIRY_FORM_ENDPOINT=
